#!/usr/bin/env bash
set -Eeuo pipefail

module=${1:?missing module}; shift
yes=false
while (($#)); do case "$1" in -y|--yes) yes=true ;; *) echo "未知参数：$1" >&2; exit 2 ;; esac; shift; done
home=${HOME:?HOME is not set}
state="${XDG_STATE_HOME:-$home/.local/state}/fedora-niri/$module"
mkdir -p "$(dirname "$state")"

ask() {
  local prompt="$1" answer
  [[ "$yes" == true ]] && return 0
  printf '%s [Y/n] ' "$prompt"
  IFS= read -r answer || answer=""
  [[ "${answer,,}" != n && "${answer,,}" != no ]]
}

kitty_file="$home/.config/kitty/kitty.conf"
kitty_state="$state/kitty-added"
kitty_add() {
  local line="$1"
  grep -Fqx -- "$line" "$kitty_file" && return 0
  printf '%s\n' "$line" >> "$kitty_file"
  printf '%s\n' "$line" >> "$kitty_state"
}
kitty_install() {
  mkdir -p "$(dirname "$kitty_file")"
  touch "$kitty_file"
  : > "$kitty_state"
  kitty_add 'shell /usr/bin/fish'
  kitty_add 'background_opacity 0.8'
}
kitty_uninstall() {
  [[ -f "$kitty_state" ]] || { echo "没有 Kitty 配置记录。"; return 1; }
  local tmp; tmp="$(mktemp)"
  cp -a "$kitty_file" "$tmp"
  while IFS= read -r line; do
    # Remove only an exact line that this module added; preserve changed lines and user content.
    awk -v target="$line" 'BEGIN{removed=0} $0==target && !removed {removed=1; next} {print}' "$tmp" > "$tmp.next"
    mv "$tmp.next" "$tmp"
  done < "$kitty_state"
  cat "$tmp" > "$kitty_file"
  rm -f "$tmp" "$kitty_state"
  rmdir "$state" 2>/dev/null || true
  echo "已移除 Kitty 模块添加且仍保持原样的配置项。"
}

fcitx_install() {
  command -v git >/dev/null || { echo "需要 git。" >&2; return 1; }
  command -v fcitx5 >/dev/null || { echo "未找到 fcitx5。" >&2; return 1; }
  command -v fcitx5-remote >/dev/null || { echo "未找到 fcitx5-remote。" >&2; return 1; }
  rpm -q fcitx5-rime >/dev/null 2>&1 || { echo "缺少 fcitx5-rime 引擎软件包；请先安装系统包。" >&2; return 1; }

  local envfile="$home/.config/environment.d/90-fcitx5.conf"
  local desktop="$home/.config/autostart/org.fcitx.Fcitx5.desktop"
  local profile="$home/.config/fcitx5/profile"
  local rime="$home/.local/share/fcitx5/rime"
  mkdir -p "$(dirname "$envfile")" "$(dirname "$desktop")" "$(dirname "$profile")" "$(dirname "$rime")"

  # Save exact originals once; do not overwrite a previous transaction.
  mkdir -p "$state/original"
  for f in "$envfile" "$desktop" "$profile"; do
    rel="${f#"$home"/}"
    if [[ -e "$f" ]]; then cp -a "$f" "$state/original/$rel"; printf 'present\t%s\n' "$rel" >> "$state/manifest"
    else printf 'absent\t%s\n' "$rel" >> "$state/manifest"; fi
  done
  cat > "$envfile" <<'EOF'
XMODIFIERS=@im=fcitx
QT_IM_MODULE=fcitx
SDL_IM_MODULE=fcitx
EOF
  cat > "$desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Fcitx 5
Exec=/usr/bin/fcitx5 -d --replace
Icon=fcitx
Terminal=false
Categories=System;
EOF
  if [[ ! -d "$rime" ]]; then
    local tmp; tmp="$(mktemp -d "$home/.local/share/fcitx5/.rime.XXXXXX")"
    if ! git clone --depth 1 https://github.com/iDvel/rime-ice.git "$tmp/rime"; then rm -rf "$tmp"; return 1; fi
    mv "$tmp/rime" "$rime"; rmdir "$tmp"
    touch "$state/rime-created"
  fi

  # Fcitx5 profile format: explicitly put Rime in the Default group.
  cat > "$profile" <<'EOF'
[Groups/0]
Name=Default
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=rime

[GroupOrder]
0=Default
EOF
  # Start detached; waiting for a daemon in the foreground caused the old task to hang.
  if ! pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
    nohup fcitx5 -d --replace >/dev/null 2>&1 </dev/null &
  else
    fcitx5-remote -r >/dev/null 2>&1 || true
  fi
  sleep 1
  pgrep -u "$(id -u)" -x fcitx5 >/dev/null || { echo "Fcitx5 启动失败，请检查 journalctl --user。" >&2; return 1; }
  echo "Rime 已写入 Fcitx5 Default 输入法组。请打开 Fcitx5 配置确认 Rime，并重新登录使环境变量生效。"
}
fcitx_uninstall() {
  [[ -f "$state/manifest" ]] || { echo "没有 Fcitx5 安装记录。"; return 1; }
  while IFS=$'\t' read -r status rel; do
    target="$home/$rel"
    if [[ -e "$target" ]]; then rm -f "$target"; fi
    if [[ "$status" == present && -e "$state/original/$rel" ]]; then
      mkdir -p "$(dirname "$target")"; cp -a "$state/original/$rel" "$target"
    fi
  done < "$state/manifest"
  if [[ -f "$state/rime-created" ]]; then rm -rf "$home/.local/share/fcitx5/rime"; fi
  rm -rf "$state"
  echo "已恢复 Fcitx5 安装前配置。"
}

install_active=false
rollback_install() {
  local rc=$?
  if [[ "$install_active" == true ]]; then
    trap - EXIT INT TERM HUP
    case "$module" in
      kitty)
        if [[ -f "$kitty_state" && -f "$kitty_file" ]]; then
          local tmp; tmp="$(mktemp)"; cp -a "$kitty_file" "$tmp"
          while IFS= read -r line; do
            awk -v target="$line" 'BEGIN{removed=0} $0==target && !removed {removed=1; next} {print}' "$tmp" > "$tmp.next"
            mv "$tmp.next" "$tmp"
          done < "$kitty_state"
          cat "$tmp" > "$kitty_file"; rm -f "$tmp"
        fi
        ;;
      fcitx)
        if [[ -f "$state/manifest" ]]; then
          while IFS=
  if [[ -e "$state/installed" ]]; then echo "该模块已安装。"; return 0; fi
  mkdir -p "$state"
  case "$module" in
    kitty) kitty_install ;;
    fcitx) : > "$state/manifest"; fcitx_install ;;
    nvim)
      [[ ! -e "$home/.config/nvim" ]] || { echo "~/.config/nvim 已存在，拒绝覆盖。" >&2; return 1; }
      git clone --depth 1 https://github.com/LazyVim/starter "$home/.config/nvim"
      rm -rf "$home/.config/nvim/.git"
      touch "$state/nvim-created"
      ;;
    dms)
      command -v duxinstall >/dev/null || { echo "未找到 duxinstall。" >&2; return 1; }
      duxinstall -c niri -t kitty -y
      ;;
    fonts) echo "字体配置请使用 fonts-setup 模块。" ;;
    *) echo "未知模块：$module" >&2; return 2 ;;
  esac
  touch "$state/installed"
  echo "安装完成。"
}
simple_uninstall() {
  case "$module" in
    kitty) kitty_uninstall; return ;;
    fcitx) fcitx_uninstall; return ;;
    nvim)
      [[ -f "$state/nvim-created" ]] || { echo "没有 Neovim 安装记录。"; return 1; }
      rm -rf "$home/.config/nvim"; rm -rf "$state"; echo "已卸载 LazyVim 配置。"; return ;;
    dms) echo "DMS 的 duxinstall 尚未提供安全的逐文件卸载清单；为避免覆盖用户修改，拒绝自动恢复整个配置目录。" >&2; return 1 ;;
    fonts) echo "字体选择由 Kitty 配置管理；请使用 kitty-setup 卸载本模块添加的配置。" ;;
  esac
}
echo "配置管理：$module"
if [[ "$yes" == true ]]; then
  [[ -e "$state/installed" ]] && { echo "该模块已安装。"; exit 0; }
  simple_install
  exit $?
fi
select action in Install Uninstall Cancel; do
  case "$action" in
    Install) simple_install; break ;;
    Uninstall)
      if ask "确认卸载 $module？"; then simple_uninstall; else echo "已取消。"; fi
      break ;;
    Cancel) echo "已取消，未修改任何文件。"; exit 0 ;;
    *) echo "无效选择。" ;;
  esac
done
\\t' read -r status rel; do
            target="$home/$rel"
            if [[ "$status" == present && -e "$state/original/$rel" ]]; then
              mkdir -p "$(dirname "$target")"; cp -a "$state/original/$rel" "$target"
            else rm -f "$target"; fi
          done < "$state/manifest"
        fi
        [[ -f "$state/rime-created" ]] && rm -rf "$home/.local/share/fcitx5/rime"
        ;;
      nvim) [[ -f "$state/nvim-created" ]] && rm -rf "$home/.config/nvim" ;;
    esac
    rm -rf "$state"
    echo "安装中断或失败：已回滚本次模块改动。" >&2
  fi
  exit "$rc"
}
trap rollback_install EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

simple_install() {
  if [[ -e "$state/installed" ]]; then echo "该模块已安装。"; return 0; fi
  mkdir -p "$state"
  case "$module" in
    kitty) kitty_install ;;
    fcitx) : > "$state/manifest"; fcitx_install ;;
    nvim)
      [[ ! -e "$home/.config/nvim" ]] || { echo "~/.config/nvim 已存在，拒绝覆盖。" >&2; return 1; }
      git clone --depth 1 https://github.com/LazyVim/starter "$home/.config/nvim"
      rm -rf "$home/.config/nvim/.git"
      touch "$state/nvim-created"
      ;;
    dms)
      command -v duxinstall >/dev/null || { echo "未找到 duxinstall。" >&2; return 1; }
      duxinstall -c niri -t kitty -y
      ;;
    fonts) echo "字体配置请使用 fonts-setup 模块。" ;;
    *) echo "未知模块：$module" >&2; return 2 ;;
  esac
  touch "$state/installed"
  echo "安装完成。"
}
simple_uninstall() {
  case "$module" in
    kitty) kitty_uninstall; return ;;
    fcitx) fcitx_uninstall; return ;;
    nvim)
      [[ -f "$state/nvim-created" ]] || { echo "没有 Neovim 安装记录。"; return 1; }
      rm -rf "$home/.config/nvim"; rm -rf "$state"; echo "已卸载 LazyVim 配置。"; return ;;
    dms) echo "DMS 的 duxinstall 尚未提供安全的逐文件卸载清单；为避免覆盖用户修改，拒绝自动恢复整个配置目录。" >&2; return 1 ;;
    fonts) echo "字体选择由 Kitty 配置管理；请使用 kitty-setup 卸载本模块添加的配置。" ;;
  esac
}
echo "配置管理：$module"
if [[ "$yes" == true ]]; then
  [[ -e "$state/installed" ]] && { echo "该模块已安装。"; exit 0; }
  simple_install
  exit $?
fi
select action in Install Uninstall Cancel; do
  case "$action" in
    Install) simple_install; break ;;
    Uninstall)
      if ask "确认卸载 $module？"; then simple_uninstall; else echo "已取消。"; fi
      break ;;
    Cancel) echo "已取消，未修改任何文件。"; exit 0 ;;
    *) echo "无效选择。" ;;
  esac
done
