#!/usr/bin/env bash
# Shared timestamped logging for Fedora Niri scripts.
setup_logging() {
  local script_name="${1:-unknown}"
  local log_root="${XDG_STATE_HOME:-${HOME:?HOME is not set}/.local/state}/fedora-niri/logs"
  mkdir -p "$log_root" || {
    printf 'ERROR: Cannot create log directory: %s\n' "$log_root" >&2
    return 1
  }
  FEDORA_NIRI_LOG_FILE="$log_root/$script_name.log"
  FEDORA_NIRI_SCRIPT_NAME="$script_name"
  export FEDORA_NIRI_LOG_FILE FEDORA_NIRI_SCRIPT_NAME
  exec > >(while IFS= read -r line || [[ -n "$line" ]]; do
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$line"
  done | tee -a "$FEDORA_NIRI_LOG_FILE") 2>&1
  printf 'Log file: %s\n' "$FEDORA_NIRI_LOG_FILE"
  printf '===== %s started (PID %s) =====\n' "$script_name" "$$"
  trap 'status=$?; printf "ERROR: %s failed at line %s (exit code %s).\\nCommand: %s\\n" "$FEDORA_NIRI_SCRIPT_NAME" "${BASH_LINENO[0]:-$LINENO}" "$status" "$BASH_COMMAND" >&2; exit "$status"' ERR
}
