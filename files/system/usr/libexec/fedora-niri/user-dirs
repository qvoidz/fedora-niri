#!/usr/bin/env bash
set -euo pipefail
: "${HOME:?HOME is not set}"
while (($#)); do case "$1" in -y|--yes) ;; *) echo "未知参数：$1" >&2; exit 2 ;; esac; shift; done
command -v xdg-user-dirs-update >/dev/null || { echo "缺少 xdg-user-dirs-update。" >&2; exit 1; }
declare -A names=(["文档"]="Documents" ["下载"]="Downloads" ["图片"]="Pictures" ["音乐"]="Music" ["视频"]="Videos" ["桌面"]="Desktop" ["模板"]="Templates" ["公共"]="Public")
mkdir -p "$HOME"
for old in "${!names[@]}"; do
 new="${names[$old]}"
 if [[ -d "$HOME/$old" && ! -e "$HOME/$new" ]]; then mv -- "$HOME/$old" "$HOME/$new"
 elif [[ -d "$HOME/$old" && -e "$HOME/$new" ]]; then echo "保留旧目录：$HOME/$old"; fi
 mkdir -p "$HOME/$new"
done
mkdir -p "$HOME/.config"
for pair in DOCUMENTS:Documents DOWNLOAD:Downloads PICTURES:Pictures MUSIC:Music VIDEOS:Videos DESKTOP:Desktop TEMPLATES:Templates PUBLICSHARE:Public; do
 key="${pair%%:*}"; val="${pair#*:}"; LC_ALL=C xdg-user-dirs-update --set "$key" "$HOME/$val"
done
printf 'enabled=False\n' > "$HOME/.config/user-dirs.conf"
printf 'C\n' > "$HOME/.config/user-dirs.locale"
echo "XDG 用户目录已固定为英文名称。"
