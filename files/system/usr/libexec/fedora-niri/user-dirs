#!/usr/bin/env bash
set -euo pipefail
: "${HOME:?ERROR: HOME is not set}"
trap 'status=$?; printf "ERROR: user-dirs failed at line %s (exit code %s).\\nCommand: %s\\n" "${BASH_LINENO[0]:-$LINENO}" "$status" "$BASH_COMMAND" >&2; exit "$status"' ERR
while (($#)); do
  case "$1" in -y|--yes) ;; *) echo "ERROR: Unknown argument: $1" >&2; exit 2 ;; esac
  shift
done

command -v xdg-user-dirs-update >/dev/null || { echo "ERROR: xdg-user-dirs-update is not installed." >&2; exit 1; }
command -v xdg-user-dir >/dev/null || { echo "ERROR: xdg-user-dir is not installed." >&2; exit 1; }

declare -A names=(
  ["文档"]="Documents"
  ["下载"]="Downloads"
  ["图片"]="Pictures"
  ["音乐"]="Music"
  ["视频"]="Videos"
  ["桌面"]="Desktop"
  ["模板"]="Templates"
  ["公共"]="Public"
)

mkdir -p "$HOME"
for old in "${!names[@]}"; do
  new="${names[$old]}"
  if [[ -d "$HOME/$old" && ! -e "$HOME/$new" ]]; then
    mv -- "$HOME/$old" "$HOME/$new"
    echo "Renamed: $old -> $new"
  elif [[ -d "$HOME/$old" && -e "$HOME/$new" ]]; then
    echo "WARNING: Both localized and English directories exist; keeping both: $HOME/$old、$HOME/$new"
  fi
  mkdir -p "$HOME/$new"
done

mkdir -p "$HOME/.config"
for pair in DOCUMENTS:Documents DOWNLOAD:Downloads PICTURES:Pictures MUSIC:Music VIDEOS:Videos DESKTOP:Desktop TEMPLATES:Templates PUBLICSHARE:Public; do
  key="${pair%%:*}"
  val="${pair#*:}"
  LC_ALL=C xdg-user-dirs-update --set "$key" "$HOME/$val"
done

# Disable future locale-based renaming and pin the directory locale to C.
printf 'enabled=False\n' > "$HOME/.config/user-dirs.conf"
printf 'C\n' > "$HOME/.config/user-dirs.locale"

# Verify that the XDG user-dir resolver now points to the intended directories.
for pair in DOCUMENTS:Documents DOWNLOAD:Downloads PICTURES:Pictures MUSIC:Music VIDEOS:Videos DESKTOP:Desktop TEMPLATES:Templates PUBLICSHARE:Public; do
  key="${pair%%:*}"
  val="${pair#*:}"
  actual="$(xdg-user-dir "$key")"
  expected="$HOME/$val"
  if [[ "$actual" != "$expected" || ! -d "$expected" ]]; then
    echo "ERROR: XDG user directory verification failed: $key -> $actual（预期 $expected）" >&2
    exit 1
  fi
done

echo "XDG user directories were created/migrated and verified successfully."
