#!/usr/bin/env bash
set -euo pipefail
: "${HOME:?HOME is not set}"
while (($#)); do
  case "$1" in -y|--yes) ;; *) echo "未知参数：$1" >&2; exit 2 ;; esac
  shift
done

command -v xdg-user-dirs-update >/dev/null || { echo "缺少 xdg-user-dirs-update。" >&2; exit 1; }
command -v xdg-user-dir >/dev/null || { echo "缺少 xdg-user-dir。" >&2; exit 1; }

declare -A names=(
  ["文档"]="Documents"
  ["下载"]="Downloads"
  ["图片"]="Pictures"
  ["音乐"]="Music"
  ["视频"]="Videos"
  ["桌面"]="Desktop"
  ["模板"]="Templates"
  ["公共"]="Public"
)

mkdir -p "$HOME"
for old in "${!names[@]}"; do
  new="${names[$old]}"
  if [[ -d "$HOME/$old" && ! -e "$HOME/$new" ]]; then
    mv -- "$HOME/$old" "$HOME/$new"
    echo "已重命名：$old -> $new"
  elif [[ -d "$HOME/$old" && -e "$HOME/$new" ]]; then
    echo "中英文目录同时存在，保留两者：$HOME/$old、$HOME/$new"
  fi
  mkdir -p "$HOME/$new"
done

mkdir -p "$HOME/.config"
for pair in DOCUMENTS:Documents DOWNLOAD:Downloads PICTURES:Pictures MUSIC:Music VIDEOS:Videos DESKTOP:Desktop TEMPLATES:Templates PUBLICSHARE:Public; do
  key="${pair%%:*}"
  val="${pair#*:}"
  LC_ALL=C xdg-user-dirs-update --set "$key" "$HOME/$val"
done

# Disable future locale-based renaming and pin the directory locale to C.
printf 'enabled=False\n' > "$HOME/.config/user-dirs.conf"
printf 'C\n' > "$HOME/.config/user-dirs.locale"

# Verify that the XDG user-dir resolver now points to the intended directories.
for pair in DOCUMENTS:Documents DOWNLOAD:Downloads PICTURES:Pictures MUSIC:Music VIDEOS:Videos DESKTOP:Desktop TEMPLATES:Templates PUBLICSHARE:Public; do
  key="${pair%%:*}"
  val="${pair#*:}"
  actual="$(xdg-user-dir "$key")"
  expected="$HOME/$val"
  if [[ "$actual" != "$expected" || ! -d "$expected" ]]; then
    echo "XDG 用户目录设置验证失败：$key -> $actual（预期 $expected）" >&2
    exit 1
  fi
done

echo "XDG 用户目录已迁移/创建并验证为英文名称。"
