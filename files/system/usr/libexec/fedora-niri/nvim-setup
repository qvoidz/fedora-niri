#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

nvim_staging=""
nvim_previous=""

rollback_install_extra() {
  [[ -z "$nvim_staging" ]] || rm -rf -- "$nvim_staging"
  [[ -z "$nvim_previous" ]] || rm -rf -- "$nvim_previous"
}

paths_for() {
  printf '%s\n' '.config/nvim'
}

do_install() {
  command -v git >/dev/null 2>&1 || {
    echo "ERROR: git is required to install the LazyVim starter, but it was not found." >&2
    return 1
  }

  local destination="$home/.config/nvim"
  local clone_status
  mkdir -p "$home/.config"
  nvim_staging="$(mktemp -d "$home/.config/.nvim-setup.XXXXXX")"

  if git clone --depth 1 --branch main https://github.com/LazyVim/starter.git "$nvim_staging"; then
    :
  else
    clone_status=$?
    rm -rf -- "$nvim_staging"
    nvim_staging=""
    echo "ERROR: Failed to clone https://github.com/LazyVim/starter.git (exit code $clone_status)." >&2
    return "$clone_status"
  fi

  if [[ ! -s "$nvim_staging/init.lua" || ! -d "$nvim_staging/lua" ]]; then
    rm -rf -- "$nvim_staging"
    nvim_staging=""
    echo "ERROR: The downloaded LazyVim starter is incomplete; init.lua or lua/ is missing." >&2
    return 1
  fi

  if [[ -e "$destination" || -L "$destination" ]]; then
    nvim_previous="$(mktemp -d "$home/.config/.nvim-previous.XXXXXX")"
    rmdir -- "$nvim_previous"
    if ! mv -- "$destination" "$nvim_previous"; then
      rm -rf -- "$nvim_staging"
      nvim_staging=""
      echo "ERROR: Could not move the existing Neovim configuration aside." >&2
      return 1
    fi
  fi

  if ! mv -- "$nvim_staging" "$destination"; then
    if [[ -n "$nvim_previous" && ( -e "$nvim_previous" || -L "$nvim_previous" ) ]]; then
      mv -- "$nvim_previous" "$destination" || {
        echo "ERROR: New Neovim configuration installation failed and the previous configuration could not be restored from $nvim_previous." >&2
        return 1
      }
      nvim_previous=""
    fi
    rm -rf -- "$nvim_staging"
    nvim_staging=""
    echo "ERROR: Could not place the LazyVim starter at $destination." >&2
    return 1
  fi

  nvim_staging=""
  if [[ -n "$nvim_previous" ]]; then
    rm -rf -- "$nvim_previous"
    nvim_previous=""
  fi

  echo "LazyVim starter installed successfully at $destination."
}

config_setup_main nvim "$@"
