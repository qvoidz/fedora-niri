#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  printf '%s\n' '.config/nvim'
}

do_install() {
  command -v git >/dev/null || { echo "ERROR: git is required but was not found." >&2; return 1; }
  mkdir -p "$home/.config"
  rm -rf -- "$home/.config/nvim"
  git clone --depth 1 https://github.com/LazyVim/starter "$home/.config/nvim"
  rm -rf "$home/.config/nvim/.git"
}

config_setup_main nvim "$@"
