#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  printf '%s\n' '.config/nvim'
}

do_install() {
  command -v git >/dev/null || { echo "ERROR: git is required but was not found." >&2; return 1; }
  mkdir -p "$home/.config"
  if [[ -e "$home/.config/nvim" || -L "$home/.config/nvim" ]]; then
    echo "Existing Neovim configuration found; preserving it."
    return 0
  fi

  local temporary
  temporary="$(mktemp -d "$home/.config/.nvim-setup.XXXXXX")"
  if ! git clone --depth 1 https://github.com/LazyVim/starter "$temporary"; then
    rm -rf -- "$temporary"
    echo "ERROR: Failed to clone the LazyVim starter configuration." >&2
    return 1
  fi
  rm -rf -- "$temporary/.git"
  if ! mv -- "$temporary" "$home/.config/nvim"; then
    rm -rf -- "$temporary"
    echo "ERROR: Failed to install the Neovim configuration." >&2
    return 1
  fi
}

config_setup_main nvim "$@"
