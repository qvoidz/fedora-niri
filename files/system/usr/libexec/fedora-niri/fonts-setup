#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  printf '%s\n' '.config/DankMaterialShell/settings.json'
}

do_install() {
  command -v fc-list >/dev/null || { echo "缺少 fc-list。" >&2; return 1; }
  command -v python3 >/dev/null || { echo "缺少 python3。" >&2; return 1; }
  local settings="$home/.config/DankMaterialShell/settings.json"
  [[ -f "$settings" ]] || {
    echo "未找到 DMS settings.json；请先运行 just dms-setup。" >&2
    return 1
  }
  mapfile -t choices < <(fc-list : family | sed 's/,.*//' | sed 's/^ *//;s/ *$//' | sort -u)
  (("${#choices[@]}" > 0)) || { echo "没有检测到可用字体。" >&2; return 1; }
  local selected=""
  if [[ "$yes" == true ]]; then
    for candidate in "Noto Sans" "Noto Sans CJK SC" "Adwaita Sans" "Inter" "Inter Variable"; do
      for available in "${choices[@]}"; do
        [[ "$available" == "$candidate" ]] && { selected="$available"; break 2; }
      done
    done
    [[ -n "$selected" ]] || selected="${choices[0]}"
  else
    echo "选择 DMS 使用的默认界面字体："
    select selected in "${choices[@]}"; do
      [[ -n "${selected:-}" ]] && break
      echo "无效选择，请重试。"
    done
  fi
  python3 - "$settings" "$selected" <<'PY'
import json
import os
import stat
import sys
import tempfile

settings_path, font_family = sys.argv[1:3]
with open(settings_path, encoding="utf-8") as stream:
    settings = json.load(stream)
if not isinstance(settings, dict):
    raise SystemExit("DMS settings.json 格式错误：根节点必须是 JSON 对象")

settings["fontFamily"] = font_family
directory = os.path.dirname(settings_path)
mode = stat.S_IMODE(os.stat(settings_path).st_mode)
fd, temporary_path = tempfile.mkstemp(prefix=".settings.json.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(settings, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
    os.chmod(temporary_path, mode)
    os.replace(temporary_path, settings_path)
except BaseException:
    try:
        os.unlink(temporary_path)
    except FileNotFoundError:
        pass
    raise
PY
  echo "已将 DMS 默认界面字体设置为：$selected"
  echo "重新启动 DMS 后生效；Kitty 配置不会被修改。"
}

config_setup_main fonts "$@"
