#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

# Kitty is managed field-by-field; never snapshot or replace kitty.conf.
paths_for() {
  :
}

config_setup_init() {
  kitty_state_file="$state_root/kitty-fields.json"
}

set_kitty_fields() {
  local conf="$home/.config/kitty/kitty.conf"
  mkdir -p "$(dirname "$conf")"
  python3 - "$conf" "$kitty_state_file" <<'PY'
import json
import os
import re
import stat
import sys
import tempfile

config_path, state_path = sys.argv[1:3]
settings = {
    "font_family": "JetBrainsMono Nerd Font",
    "bold_font": "auto",
    "italic_font": "auto",
    "bold_italic_font": "auto",
    "shell": "/usr/bin/fish",
    "background_opacity": "0.8",
}
pattern = re.compile(r"^\s*([a-zA-Z0-9_]+)(?:\s+|$)")
existed = os.path.isfile(config_path)
try:
    with open(config_path, encoding="utf-8") as stream:
        lines = stream.readlines()
except FileNotFoundError:
    lines = []

if os.path.isfile(state_path):
    # Keep the pre-install values across upgrades; never replace them with
    # values written by an earlier setup/refresh.
    with open(state_path, encoding="utf-8") as stream:
        state = json.load(stream)
    if not isinstance(state, dict) or not isinstance(state.get("fields"), dict):
        raise SystemExit("ERROR: Kitty rollback record is invalid; refusing to overwrite it.")
else:
    state = {"config_existed": existed, "fields": {}}
    for key, value in settings.items():
        matches = [line.rstrip("\n") for line in lines
                   if (m := pattern.match(line)) and m.group(1) == key
                   and not line.lstrip().startswith("#")]
        state["fields"][key] = {"present": bool(matches), "lines": matches}

    # Persist the original rollback data before touching kitty.conf.
    os.makedirs(os.path.dirname(state_path), exist_ok=True)
    fd, temp_state = tempfile.mkstemp(prefix=".kitty-fields.", dir=os.path.dirname(state_path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(state, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        os.replace(temp_state, state_path)
    except BaseException:
        try: os.unlink(temp_state)
        except FileNotFoundError: pass
        raise

for key, value in settings.items():
    found = False
    updated = []
    for line in lines:
        match = pattern.match(line)
        if match and match.group(1) == key and not line.lstrip().startswith("#"):
            if not found:
                updated.append(f"{key} {value}\n")
                found = True
        else:
            updated.append(line)
    if not found:
        updated.append(f"{key} {value}\n")
    lines = updated

mode = stat.S_IMODE(os.stat(config_path).st_mode) if existed else 0o644
fd, temp_config = tempfile.mkstemp(prefix=".kitty.conf.", dir=os.path.dirname(config_path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.writelines(lines)
    os.chmod(temp_config, mode)
    os.replace(temp_config, config_path)
except BaseException:
    try: os.unlink(temp_config)
    except FileNotFoundError: pass
    raise
PY
}

restore_kitty_fields() {
  local conf="$home/.config/kitty/kitty.conf"
  [[ -f "$kitty_state_file" ]] || {
    echo "ERROR: Kitty field restoration record is missing; refusing to discard module state." >&2
    return 1
  }
  python3 - "$conf" "$kitty_state_file" <<'PY'
import json
import os
import re
import stat
import sys
import tempfile

config_path, state_path = sys.argv[1:3]
with open(state_path, encoding="utf-8") as stream:
    state = json.load(stream)
try:
    with open(config_path, encoding="utf-8") as stream:
        lines = stream.readlines()
except FileNotFoundError:
    raise SystemExit(0)

pattern = re.compile(r"^\s*([a-zA-Z0-9_]+)(?:\s+|$)")
for key, original in state["fields"].items():
    indexes = [i for i, line in enumerate(lines)
               if (m := pattern.match(line)) and m.group(1) == key
               and not line.lstrip().startswith("#")]
    # If the field was removed after installation, leave it alone.
    if not indexes:
        continue
    first = indexes[0]
    replacement = [line + "\n" for line in original["lines"]]
    remove = set(indexes)
    lines = [line for i, line in enumerate(lines) if i not in remove]
    lines[first:first] = replacement

mode = stat.S_IMODE(os.stat(config_path).st_mode)
fd, temp_config = tempfile.mkstemp(prefix=".kitty.conf.", dir=os.path.dirname(config_path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.writelines(lines)
    os.chmod(temp_config, mode)
    os.replace(temp_config, config_path)
except BaseException:
    try: os.unlink(temp_config)
    except FileNotFoundError: pass
    raise

if not state["config_existed"] and not lines:
    os.unlink(config_path)
PY
}

rollback_install_extra() {
  restore_kitty_fields
}

after_uninstall() {
  restore_kitty_fields
}

do_install() {
  command -v python3 >/dev/null || { echo "ERROR: python3 is required but was not found." >&2; return 1; }
  set_kitty_fields
}

config_setup_main kitty "$@"
