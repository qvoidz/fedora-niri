#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  # Only paths owned by DMS/duxinstall; never snapshot the entire user systemd directory.
  printf '%s\n' '.config/niri' '.config/quickshell' '.config/kitty' '.config/dms' '.config/DankMaterialShell' '.local/share/dms' '.local/state/dms' '.cache/dms'
}

before_uninstall() {
  systemctl --user disable --now dms.service 2>/dev/null || true
}

after_uninstall() {
  systemctl --user daemon-reload 2>/dev/null || true
}

do_install() {
  command -v duxinstall >/dev/null || { echo "未找到 duxinstall。" >&2; return 1; }

  # Install every optional Dux component except Dux Files; retain Nautilus as file manager.
  duxinstall -c niri -t kitty --all-features --exclude-deps dux-files --replace-configs niri,kitty -y

  # Fedora Atomic/bootc: duxinstall layers the greeter package but does not configure it.
  command -v dms-greeter >/dev/null || { echo "未找到 dms-greeter；请确认 dux-greeter 已加入系统镜像。" >&2; return 1; }
  dms-greeter install --yes

  # Set the default DMS interface font without replacing the user's other settings.
  local settings="$home/.config/DankMaterialShell/settings.json"
  [[ -f "$settings" ]] || {
    echo "未找到 DMS settings.json；DMS 安装可能未生成默认配置。" >&2
    return 1
  }
  command -v python3 >/dev/null || { echo "缺少 python3。" >&2; return 1; }
  python3 - "$settings" <<'PY'
import json
import os
import stat
import sys
import tempfile

settings_path = sys.argv[1]
with open(settings_path, encoding="utf-8") as stream:
    settings = json.load(stream)
if not isinstance(settings, dict):
    raise SystemExit("DMS settings.json 格式错误：根节点必须是 JSON 对象")

settings["fontFamily"] = "Noto Sans"
directory = os.path.dirname(settings_path)
mode = stat.S_IMODE(os.stat(settings_path).st_mode)
fd, temporary_path = tempfile.mkstemp(prefix=".settings.json.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(settings, stream, ensure_ascii=False, indent=2)
        stream.write("\\n")
    os.chmod(temporary_path, mode)
    os.replace(temporary_path, settings_path)
except BaseException:
    try:
        os.unlink(temporary_path)
    except FileNotFoundError:
        pass
    raise
PY
  echo "已将 DMS 默认界面字体设置为：Noto Sans"

  # Use GNOME Files (Nautilus) with Kitty in its right-click terminal menu.
  local schema='com.github.stunkymonkey.nautilus-open-any-terminal'
  if ! gsettings list-schemas | grep -Fxq "$schema"; then
    echo "未找到 Nautilus Open Any Terminal 的 GSettings schema。" >&2
    return 1
  fi
  gsettings set "$schema" terminal kitty
  nautilus -q 2>/dev/null || true
}

config_setup_main dms "$@"
