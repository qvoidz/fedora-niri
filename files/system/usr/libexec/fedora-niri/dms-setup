#!/usr/bin/env bash
set -Eeuo pipefail
export DMS_PRIVESC=sudo
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  # Only paths owned by DMS/duxinstall; never snapshot the entire user systemd directory.
  printf '%s\n' '.config/niri' '.config/quickshell' '.config/kitty' '.config/dms' '.local/share/dms' '.local/state/dms' '.cache/dms'
}

before_uninstall() {
  command -v dms-greeter >/dev/null || {
    echo "ERROR: dms-greeter was not found; cannot undo Greeter configuration." >&2
    return 1
  }
  dms-greeter uninstall --yes
  systemctl --user disable --now dms.service 2>/dev/null || true
}

after_uninstall() {
  systemctl --user daemon-reload 2>/dev/null || true
}

# Greeter changes system-level files and permissions outside the user backup.
# Undo those changes as part of config-setup's failed-install rollback.
rollback_install_extra() {
  local result=0
  if [[ -e "$state_root/greeter-installing" || -e "$state_root/greeter-configured" ]]; then
    if command -v dms-greeter >/dev/null && dms-greeter uninstall --yes; then
      rm -f "$state_root/greeter-installing" "$state_root/greeter-configured"
    else
      echo "ERROR: DMS Greeter rollback failed. Run dms-greeter uninstall manually." >&2
      result=1
    fi
  fi
  restore || result=1
  return "$result"
}

do_install() {
  command -v duxinstall >/dev/null || { echo "ERROR: duxinstall was not found." >&2; return 1; }

  # Configure Dux components; this does not install system packages.
  duxinstall -c niri -t kitty --all-features --exclude-deps dux-files --replace-configs niri,kitty -y

  # On Fedora Atomic/bootc, the package is already in the image.
  # Run the post-deployment Greeter setup as the normal user.
  command -v dms-greeter >/dev/null || { echo "ERROR: dms-greeter was not found. Ensure dux-greeter is included in the system image." >&2; return 1; }
  touch "$state_root/greeter-installing"
  dms-greeter install --yes
  touch "$state_root/greeter-configured"
  rm -f "$state_root/greeter-installing"

  # Set the default DMS interface font without replacing the user's other settings.
  local settings="$home/.config/dms/settings.json"
  [[ -f "$settings" ]] || {
    echo "ERROR: DMS settings.json was not found at $settings." >&2
    return 1
  }
  command -v python3 >/dev/null || { echo "ERROR: python3 is required but was not found." >&2; return 1; }
  python3 - "$settings" <<'PY'
import json
import os
import stat
import sys
import tempfile

settings_path = sys.argv[1]
with open(settings_path, encoding="utf-8") as stream:
    settings = json.load(stream)
if not isinstance(settings, dict):
    raise SystemExit("ERROR: Invalid DMS settings.json: the root value must be a JSON object")

settings["fontFamily"] = "Noto Sans"
directory = os.path.dirname(settings_path)
mode = stat.S_IMODE(os.stat(settings_path).st_mode)
fd, temporary_path = tempfile.mkstemp(prefix=".settings.json.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(settings, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
    os.chmod(temporary_path, mode)
    os.replace(temporary_path, settings_path)
except BaseException:
    try:
        os.unlink(temporary_path)
    except FileNotFoundError:
        pass
    raise
PY
  echo "DMS default interface font set to Noto Sans."

  # Use GNOME Files (Nautilus) with Kitty in its right-click terminal menu.
  local schema='com.github.stunkymonkey.nautilus-open-any-terminal'
  if ! gsettings list-schemas | grep -Fxq "$schema"; then
    echo "ERROR: Nautilus Open Any Terminal GSettings schema was not found." >&2
    return 1
  fi
  gsettings set "$schema" terminal kitty
  nautilus -q 2>/dev/null || true
}

config_setup_main dms "$@"
