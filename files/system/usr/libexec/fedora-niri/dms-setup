#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  # Kitty is managed independently by kitty-setup, not by DMS snapshots.
  printf '%s\n' '.config/niri' '.config/quickshell' '.config/dms' '.local/share/dms' '.local/state/dms' '.cache/dms'
}

before_uninstall() {
  systemctl --user disable --now dms.service 2>/dev/null || true
}

after_uninstall() {
  systemctl --user daemon-reload 2>/dev/null || true
}

do_install() {
  command -v duxinstall >/dev/null || { echo "未找到 duxinstall。" >&2; return 1; }
  duxinstall -c niri -t kitty -y
}

config_setup_main dms "$@"
