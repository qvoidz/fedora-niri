#!/usr/bin/env bash
set -Eeuo pipefail
export DMS_PRIVESC=sudo
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  printf '%s\n' '.config/dms' '.local/share/dms' '.local/state/dms' '.cache/dms'
}

restore_greetd_config() {
  local original="$state_root/greetd-config.toml.original"
  if [[ -f "$original" ]]; then
    sudo install -m 0644 "$original" /etc/greetd/config.toml
  elif [[ -f "$state_root/greetd-config-was-absent" ]]; then
    sudo rm -f /etc/greetd/config.toml
  fi
  rm -f "$original" "$state_root/greetd-config-was-present" "$state_root/greetd-config-was-absent"
}

before_uninstall() {
  if command -v dms-greeter >/dev/null 2>&1; then
    dms-greeter uninstall --yes
  else
    echo "ERROR: dms-greeter is unavailable; cannot safely undo its system configuration." >&2
    return 1
  fi
}

after_uninstall() {
  restore_greetd_config
  systemctl --user disable --now dms.service 2>/dev/null || true
}

rollback_install_extra() {
  local result=0
  if [[ -e "$state_root/greeter-installing" || -e "$state_root/greeter-configured" ]]; then
    dms-greeter uninstall --yes || result=1
  fi
  restore_greetd_config || result=1
  restore || result=1
  return "$result"
}

configure_greetd_locale() {
  local config=/etc/greetd/config.toml
  [[ -f "$config" ]] || {
    echo "ERROR: DMS Greeter did not create $config." >&2
    return 1
  }
  if grep -q 'LANG=zh_CN.UTF-8' "$config"; then
    echo "greetd Chinese locale is already configured."
    return 0
  fi
  sudo python3 - "$config" <<'PY'
import os, re, stat, sys, tempfile
path = sys.argv[1]
with open(path, encoding="utf-8") as stream:
    lines = stream.readlines()
section = None
changed = False
for index, line in enumerate(lines):
    header = re.match(r"^\s*\[([^]]+)\]\s*(?:#.*)?$", line)
    if header:
        section = header.group(1)
        continue
    if section != "default_session":
        continue
    match = re.match(r'^(\s*command\s*=\s*")([^"]*)(".*)$', line.rstrip("\n"))
    if match:
        command = match.group(2)
        if not re.search(r"(?:^|\s)LANG=zh_CN\.UTF-8(?:\s|$)", command):
            command = "env LANG=zh_CN.UTF-8 " + command
        lines[index] = match.group(1) + command + match.group(3) + ("\n" if line.endswith("\n") else "")
        changed = True
        break
if not changed:
    raise SystemExit("ERROR: Could not find [default_session].command in greetd config.")
mode = stat.S_IMODE(os.stat(path).st_mode)
fd, temporary = tempfile.mkstemp(prefix=".greetd.", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.writelines(lines)
    os.chmod(temporary, mode)
    os.replace(temporary, path)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
}

do_install() {
  command -v dms-greeter >/dev/null || {
    echo "ERROR: dms-greeter is missing; ensure dux-greeter is installed in the image." >&2
    return 1
  }
  local greetd_config=/etc/greetd/config.toml
  if [[ -e "$greetd_config" ]]; then
    sudo cp -a "$greetd_config" "$state_root/greetd-config.toml.original"
    touch "$state_root/greetd-config-was-present"
  else
    touch "$state_root/greetd-config-was-absent"
  fi
  touch "$state_root/greeter-installing"
  dms-greeter install --yes
  touch "$state_root/greeter-configured"
  rm -f "$state_root/greeter-installing"
  configure_greetd_locale

  local settings="$home/.config/dms/settings.json"
  [[ -f "$settings" ]] || {
    echo "ERROR: DMS settings.json was not created at $settings." >&2
    return 1
  }
  python3 - "$settings" <<'PY'
