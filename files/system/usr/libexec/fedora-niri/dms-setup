    "dms_settings_search": {"trigger": "?"}
  },
  "springBounce": 2
}''')
with open(path, encoding="utf-8") as stream:
    settings = json.load(stream)
if not isinstance(settings, dict):
    raise SystemExit("ERROR: DMS settings.json root must be a JSON object.")
settings.update(seed)
mode = stat.S_IMODE(os.stat(path).st_mode)
fd, temporary = tempfile.mkstemp(prefix=".settings.", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(settings, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
    os.chmod(temporary, mode)
    os.replace(temporary, path)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
  echo "DMS settings and Greeter configuration completed successfully."
}

config_setup_main dms "$@"
