#!/usr/bin/env bash
set -Eeuo pipefail

locale="zh_CN.UTF-8"
login_shell="${SHELL:-}"

# Keep the user's normal login-shell initialization, then restore LANG after
# Fedora's /etc/profile.d/lang.sh has applied its TTY fallback.
if [[ -n "$login_shell" && -x "$login_shell" ]] && grep -Fqx -- "$login_shell" /etc/shells 2>/dev/null; then
  case "${login_shell##*/}" in
    fish)
      exec "$login_shell" -l -c 'set -gx LANG zh_CN.UTF-8; exec niri-session -l'
      ;;
    bash|zsh|sh|dash|ksh)
      exec "$login_shell" -l -c 'export LANG=zh_CN.UTF-8; exec niri-session -l'
      ;;
  esac
fi

export LANG="$locale"
exec niri-session -l
