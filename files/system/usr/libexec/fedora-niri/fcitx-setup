#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  printf '%s\n' '.config/environment.d/90-fcitx5.conf' '.config/autostart/org.fcitx.Fcitx5.desktop' '.config/fcitx5/profile' '.local/share/fcitx5/rime'
}

before_uninstall() {
  fcitx5-remote -e >/dev/null 2>&1 || true
}

write_environment() {
  local destination="$home/.config/environment.d/90-fcitx5.conf"
  local temporary="$destination.tmp"
  mkdir -p "$(dirname "$destination")"
  cat > "$temporary" <<'EOF'
GTK_IM_MODULE=fcitx
QT_IM_MODULE=fcitx
SDL_IM_MODULE=fcitx
XMODIFIERS=@im=fcitx
EOF
  mv -f -- "$temporary" "$destination"
}

write_autostart() {
  local destination="$home/.config/autostart/org.fcitx.Fcitx5.desktop"
  local temporary="$destination.tmp"
  mkdir -p "$(dirname "$destination")"
  cat > "$temporary" <<'EOF'
[Desktop Entry]
Type=Application
Name=Fcitx 5
Exec=/usr/bin/fcitx5 -d --replace
Icon=fcitx
Terminal=false
Categories=System;
EOF
  mv -f -- "$temporary" "$destination"
}

write_profile() {
  local destination="$home/.config/fcitx5/profile"
  local temporary="$destination.tmp"
  mkdir -p "$(dirname "$destination")"
  cat > "$temporary" <<'EOF'
[Groups/0]
Name=Default
DefaultIM=rime

[Groups/0/Items/0]
Name=rime

[Groups/0/Items/1]
Name=keyboard-us
Layout=

[GroupOrder]
0=Default

[Groups]
0=Default
EOF
  mv -f -- "$temporary" "$destination"
}

update_rime_config() {
  local rime_dir="$home/.local/share/fcitx5/rime"
  local tmp clone_status
  mkdir -p "$home/.local/share/fcitx5"

  if [[ -d "$rime_dir/.git" ]]; then
    echo "Updating Rime Ice configuration..."
    git -C "$rime_dir" pull --ff-only
  elif [[ -e "$rime_dir" || -L "$rime_dir" ]]; then
    echo "ERROR: Rime directory exists but is not a Git repository; refusing to overwrite: $rime_dir" >&2
    return 1
  else
    tmp="$(mktemp -d "$home/.local/share/fcitx5/.rime.XXXXXX")"
    if git clone --depth 1 https://github.com/iDvel/rime-ice.git "$tmp/rime"; then
      :
    else
      clone_status=$?
      rm -rf -- "$tmp"
      echo "ERROR: Failed to clone https://github.com/iDvel/rime-ice.git (exit code $clone_status)." >&2
      return "$clone_status"
    fi
    if ! mv -- "$tmp/rime" "$rime_dir"; then
      rm -rf -- "$tmp"
      echo "ERROR: Failed to install the Rime Ice configuration at $rime_dir." >&2
      return 1
    fi
    rmdir -- "$tmp"
  fi
}

start_fcitx() {
  local uid current attempt
  uid="$(id -u)"

  if pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1; then
    echo "Restarting Fcitx5 to load the updated profile..."
    fcitx5-remote -r
  else
    echo "Starting Fcitx5..."
    nohup fcitx5 -d --replace >"$state_root/fcitx5.log" 2>&1 </dev/null &
  fi

  for attempt in {1..50}; do
    if pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1 && fcitx5-remote -n >/dev/null 2>&1; then
      break
    fi
    sleep 0.2
  done

  if ! pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1; then
    echo "ERROR: Fcitx5 did not start. Check $state_root/fcitx5.log for details." >&2
    return 1
  fi

  fcitx5-remote -s rime
  current="$(fcitx5-remote -n)"
  if [[ "$current" != "rime" ]]; then
    echo "ERROR: Fcitx5 is running, but Rime is not the active input method (current: ${current:-unknown}). Check that fcitx5-rime is installed and inspect the Fcitx5 profile." >&2
    return 1
  fi
}

after_already_installed() {
  command -v git >/dev/null 2>&1 || { echo "ERROR: git is required but was not found." >&2; return 1; }
  command -v fcitx5 >/dev/null 2>&1 || { echo "ERROR: fcitx5 was not found." >&2; return 1; }
  command -v fcitx5-remote >/dev/null 2>&1 || { echo "ERROR: fcitx5-remote was not found." >&2; return 1; }
  update_rime_config
  write_profile
  start_fcitx
}

do_install() {
  command -v git >/dev/null 2>&1 || { echo "ERROR: git is required but was not found." >&2; return 1; }
  command -v fcitx5 >/dev/null 2>&1 || { echo "ERROR: fcitx5 was not found." >&2; return 1; }
  command -v fcitx5-remote >/dev/null 2>&1 || { echo "ERROR: fcitx5-remote was not found." >&2; return 1; }
  command -v pgrep >/dev/null 2>&1 || { echo "ERROR: pgrep is required to check the Fcitx5 daemon." >&2; return 1; }

  write_environment
  write_autostart
  update_rime_config
  write_profile
  start_fcitx

  echo "Fcitx5 and Rime configured successfully. Rime is the default input method; log out and back in to apply environment variables."
}

config_setup_main fcitx "$@"
