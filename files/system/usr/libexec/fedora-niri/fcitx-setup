#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

rime_staging=""

rollback_install_extra() {
  [[ -z "$rime_staging" ]] || rm -rf -- "$rime_staging"
}

paths_for() {
  printf '%s\n' '.config/environment.d/90-fcitx5.conf' '.config/autostart/org.fcitx.Fcitx5.desktop' '.config/fcitx5/profile' '.config/fcitx5/config' '.local/share/fcitx5/rime'
}

before_uninstall() {
  fcitx5-remote -e >/dev/null 2>&1 || true
}

write_environment() {
  local destination="$home/.config/environment.d/90-fcitx5.conf"
  local temporary="$destination.tmp"
  mkdir -p "$(dirname "$destination")"
  cat > "$temporary" <<'EOF'
GTK_IM_MODULE=fcitx
QT_IM_MODULE=fcitx
SDL_IM_MODULE=fcitx
XMODIFIERS=@im=fcitx
EOF
  mv -f -- "$temporary" "$destination"
}

write_autostart() {
  local destination="$home/.config/autostart/org.fcitx.Fcitx5.desktop"
  local temporary="$destination.tmp"
  mkdir -p "$(dirname "$destination")"
  cat > "$temporary" <<'EOF'
[Desktop Entry]
Type=Application
Name=Fcitx 5
Exec=/usr/bin/fcitx5 -rd
Icon=fcitx
Terminal=false
Categories=System;
EOF
  mv -f -- "$temporary" "$destination"
}

write_profile() {
  local destination="$home/.config/fcitx5/profile"
  local temporary="$destination.tmp"
  mkdir -p "$(dirname "$destination")"
  cat > "$temporary" <<'EOF'
[Groups/0]
Name=Default
DefaultIM=rime

[Groups/0/Items/0]
Name=rime

[Groups/0/Items/1]
Name=keyboard-us
Layout=

[GroupOrder]
0=Default

[Groups]
0=Default
EOF
  mv -f -- "$temporary" "$destination"
}

clear_temporary_toggle_hotkey() {
  local destination="$home/.config/fcitx5/config"
  mkdir -p "$(dirname "$destination")"
  python3 - "$destination" <<'PY'
import os
import re
import stat
import sys
import tempfile

path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as stream:
        lines = stream.readlines()
    mode = stat.S_IMODE(os.stat(path).st_mode)
except FileNotFoundError:
    lines = []
    mode = 0o644

output = []
section = None
found_section = False
written_key = False

for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        if section == "Hotkey" and not written_key:
            output.append("AltTriggerKeys=\n")
            written_key = True
        section = stripped[1:-1]
        found_section = found_section or section == "Hotkey"
        output.append(line)
        continue

    if section == "Hotkey" and re.match(r"^\s*AltTriggerKeys\s*=", line):
        if not written_key:
            output.append("AltTriggerKeys=\n")
            written_key = True
        continue

    output.append(line)

if section == "Hotkey" and not written_key:
    output.append("AltTriggerKeys=\n")
    written_key = True

if not found_section:
    if output and not output[-1].endswith("\n"):
        output[-1] += "\n"
    if output and output[-1].strip():
        output.append("\n")
    output.extend(["[Hotkey]\n", "AltTriggerKeys=\n"])

directory = os.path.dirname(path)
fd, temporary = tempfile.mkstemp(prefix=".fcitx-config.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.writelines(output)
    os.chmod(temporary, mode)
    os.replace(temporary, path)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
}

update_rime_config() {
  local rime_dir="$home/.local/share/fcitx5/rime"
  local clone_status
  mkdir -p "$home/.local/share/fcitx5"

  if [[ -d "$rime_dir/.git" ]]; then
    echo "Updating Rime Ice configuration..."
    git -C "$rime_dir" pull --ff-only
  elif [[ -e "$rime_dir" || -L "$rime_dir" ]]; then
    echo "ERROR: Rime directory exists but is not a Git repository; refusing to overwrite: $rime_dir" >&2
    return 1
  else
    rime_staging="$(mktemp -d "$home/.local/share/fcitx5/.rime.XXXXXX")
    if git clone --depth 1 https://github.com/iDvel/rime-ice.git "$rime_staging/rime"; then
      :
    else
      clone_status=$?
      rm -rf -- "$rime_staging"
      rime_staging=""
      echo "ERROR: Failed to clone https://github.com/iDvel/rime-ice.git (exit code $clone_status)." >&2
      return "$clone_status"
    fi
    if ! mv -- "$rime_staging/rime" "$rime_dir"; then
      rm -rf -- "$rime_staging"
      rime_staging=""
      echo "ERROR: Failed to install the Rime Ice configuration at $rime_dir." >&2
      return 1
    fi
    rmdir -- "$rime_staging"
    rime_staging=""
  fi
}

start_fcitx() {
  local uid attempt
  uid="$(id -u)"

  if pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1; then
    echo "Stopping the running Fcitx5 daemon before reloading its profile..."
    fcitx5-remote -e
    for attempt in {1..50}; do
      if ! pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1; then
        break
      fi
      sleep 0.2
    done
    if pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1; then
      echo "ERROR: The existing Fcitx5 daemon did not exit." >&2
      return 1
    fi
  fi

  echo "Starting Fcitx5..."
  nohup fcitx5 -d >"$state_root/fcitx5.log" 2>&1 </dev/null &

  for attempt in {1..50}; do
    if pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1 && fcitx5-remote -n >/dev/null 2>&1; then
      break
    fi
    sleep 0.2
  done

  if ! pgrep -u "$uid" -x fcitx5 >/dev/null 2>&1; then
    echo "ERROR: Fcitx5 did not start. Check $state_root/fcitx5.log for details." >&2
    return 1
  fi

  fcitx5-remote -s rime
  current="$(fcitx5-remote -n)"
  if [[ "$current" != "rime" ]]; then
    echo "ERROR: Fcitx5 is running, but Rime is not the active input method (current: ${current:-unknown}). Check that fcitx5-rime is installed and inspect the Fcitx5 profile." >&2
    return 1
  fi
}

after_already_installed() {
  command -v git >/dev/null 2>&1 || { echo "ERROR: git is required but was not found." >&2; return 1; }
  command -v fcitx5 >/dev/null 2>&1 || { echo "ERROR: fcitx5 was not found." >&2; return 1; }
  command -v fcitx5-remote >/dev/null 2>&1 || { echo "ERROR: fcitx5-remote was not found." >&2; return 1; }
  command -v pgrep >/dev/null 2>&1 || { echo "ERROR: pgrep was not found." >&2; return 1; }
  update_rime_config
  write_profile
  clear_temporary_toggle_hotkey
  start_fcitx
}

do_install() {
  command -v git >/dev/null 2>&1 || { echo "ERROR: git is required but was not found." >&2; return 1; }
  command -v fcitx5 >/dev/null 2>&1 || { echo "ERROR: fcitx5 was not found." >&2; return 1; }
  command -v fcitx5-remote >/dev/null 2>&1 || { echo "ERROR: fcitx5-remote was not found." >&2; return 1; }
  command -v pgrep >/dev/null 2>&1 || { echo "ERROR: pgrep is required to check the Fcitx5 daemon." >&2; return 1; }

  write_environment
  write_autostart
  update_rime_config
  write_profile
  clear_temporary_toggle_hotkey
  start_fcitx

  echo "Fcitx5 and Rime configured successfully. Rime is the default input method; log out and back in to apply environment variables."
}

config_setup_main fcitx "$@"
