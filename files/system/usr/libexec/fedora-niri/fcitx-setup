#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/libexec/fedora-niri/config-setup

paths_for() {
  printf '%s\n' '.config/environment.d/90-fcitx5.conf' '.config/autostart/org.fcitx.Fcitx5.desktop' '.config/fcitx5/profile' '.local/share/fcitx5/rime'
}

before_uninstall() {
  fcitx5-remote -e 2>/dev/null || true
}

update_rime_config() {
  local rime_dir="$home/.local/share/fcitx5/rime"
  mkdir -p "$home/.local/share/fcitx5"

  if [[ -d "$rime_dir/.git" ]]; then
    echo "Updating Rime Ice configuration..."
    git -C "$rime_dir" pull --ff-only
  elif [[ -e "$rime_dir" ]]; then
    echo "ERROR: Rime directory exists but is not a Git repository; refusing to overwrite: $rime_dir" >&2
    return 1
  else
    local tmp
    tmp="$(mktemp -d "$home/.local/share/fcitx5/.rime.XXXXXX")"
    if ! git clone --depth 1 https://github.com/iDvel/rime-ice.git "$tmp/rime"; then
      rm -rf "$tmp"
      return 1
    fi
    mv "$tmp/rime" "$rime_dir"
    rmdir "$tmp"
  fi
}

# Refresh Rime even when the Fcitx configuration module is already marked configured.
after_already_installed() {
  command -v git >/dev/null || { echo "ERROR: git is required but was not found." >&2; return 1; }
  update_rime_config
}

do_install() {
  command -v git >/dev/null || { echo "ERROR: git is required but was not found." >&2; return 1; }
  command -v fcitx5 >/dev/null || { echo "ERROR: fcitx5 was not found." >&2; return 1; }
  command -v fcitx5-remote >/dev/null || { echo "ERROR: fcitx5-remote was not found." >&2; return 1; }

  mkdir -p "$home/.config/environment.d" "$home/.config/autostart" "$home/.config/fcitx5" "$home/.local/share/fcitx5"

  cat > "$home/.config/environment.d/90-fcitx5.conf" <<'EOF'
XMODIFIERS=@im=fcitx
QT_IM_MODULE=fcitx
SDL_IM_MODULE=fcitx
EOF

  cat > "$home/.config/autostart/org.fcitx.Fcitx5.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Fcitx 5
Exec=/usr/bin/fcitx5 -d --replace
Icon=fcitx
Terminal=false
Categories=System;
EOF

  update_rime_config

  cat > "$home/.config/fcitx5/profile" <<'EOF'
[Groups/0]
Name=Default
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=rime

[GroupOrder]
0=Default

[Groups]
0=Default
EOF

  if pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
    fcitx5-remote -r >/dev/null 2>&1 || true
  else
    nohup fcitx5 -d --replace >/dev/null 2>&1 </dev/null &
  fi
  echo "Fcitx5 configuration and Rime Ice update completed successfully. Log out and back in to apply session environment variables."
}

config_setup_main fcitx "$@"
