#!/usr/bin/env bash
set -Eeuo pipefail
: "${HOME:?ERROR: HOME is not set}"
trap 'status=$?; printf "ERROR: cleanup failed at line %s (exit code %s).\\nCommand: %s\\n" "${BASH_LINENO[0]:-$LINENO}" "$status" "$BASH_COMMAND" >&2; exit "$status"' ERR

if (($# > 1)) || { (($# == 1)) && [[ "$1" != "-y" ]]; }; then
  echo "Usage: just cleanup [-y]" >&2
  exit 2
fi

yes_all=false
[[ "${1:-}" == "-y" ]] && yes_all=true
cleanup_errors=()

ask() {
  local label="$1" answer
  if [[ "$yes_all" == true ]]; then
    return 0
  fi
  printf '%s [Y/n] ' "$label"
  IFS= read -r answer || answer=""
  case "${answer,,}" in n|no) return 1 ;; *) return 0 ;; esac
}

run_module_uninstall() {
  local module="$1" script="/usr/libexec/fedora-niri/$1-setup"
  local state_root="${XDG_STATE_HOME:-$HOME/.local/state}/fedora-niri/config-setup/$module"
  if [[ ! -f "$state_root/installed" && ! -f "$state_root/failed" && ! -f "$state_root/installing" ]]; then
    printf 'SKIPPED (no installation record): %s configuration\\n' "$module"
    return 0
  fi
  if [[ ! -r "$script" ]]; then
    printf 'ERROR: Uninstall script not found or not readable: %s\\n' "$script" >&2
    cleanup_errors+=("$module configuration")
    return 1
  fi
  if bash "$script" --uninstall --yes; then
    printf 'Removed: %s configuration\\n' "$module"
  else
    printf 'ERROR: Failed to restore/remove %s configuration.\\n' "$module" >&2
    cleanup_errors+=("$module configuration")
    return 1
  fi
}

remove_paths() {
  local path
  for path in "$@"; do
    if [[ ! -e "$path" && ! -L "$path" ]]; then
      printf 'SKIPPED (not found): %s\\n' "$path"
      continue
    fi
    if rm -rf -- "$path"; then
      printf 'Removed: %s\\n' "$path"
    else
      printf 'ERROR: Failed to remove: %s\\n' "$path" >&2
      cleanup_errors+=("$path")
    fi
  done
}

remove_flatpaks() {
  local flatpak_config="/usr/share/bluebuild/default-flatpaks/configuration.yml"
  local flatpak_allowlist scope app_id app_data
  local -a preserved_flatpaks=()
  if ! command -v flatpak >/dev/null 2>&1; then
    echo "WARNING: flatpak command not found; skipping Flatpak cleanup."
    return 0
  fi
  if [[ ! -r "$flatpak_config" ]]; then
    echo "ERROR: BlueBuild Flatpak configuration not found; refusing Flatpak removal." >&2
    cleanup_errors+=("Flatpak allowlist configuration")
    return 1
  fi
  if ! command -v yq >/dev/null 2>&1; then
    echo "ERROR: yq command not found; cannot read the BlueBuild Flatpak allowlist." >&2
    cleanup_errors+=("Flatpak allowlist parser")
    return 1
  fi
  if ! flatpak_allowlist="$(yq -r '.system.install[]?, .user.install[]?' "$flatpak_config")"; then
    echo "ERROR: Failed to read the BlueBuild Flatpak allowlist." >&2
    cleanup_errors+=("Flatpak allowlist parsing")
    return 1
  fi
  mapfile -t preserved_flatpaks < <(printf '%s\\n' "$flatpak_allowlist" | sed 's#//.*$##' | sed '/^[[:space:]]*$/d')

  is_preserved_flatpak() {
    local candidate="$1" configured
    candidate="${candidate%%//*}"
    for configured in "${preserved_flatpaks[@]}"; do
      configured="${configured%%//*}"
      [[ "$candidate" == "$configured" ]] && return 0
    done
    return 1
  }

  for scope in system user; do
    local installed_output
    if [[ "$scope" == system ]]; then
      if ! installed_output="$(flatpak list --system --app --columns=application)"; then
        echo "ERROR: Failed to list system Flatpak applications." >&2
        cleanup_errors+=("system Flatpak listing")
        continue
      fi
    else
      if ! installed_output="$(flatpak list --user --app --columns=application)"; then
        echo "ERROR: Failed to list user Flatpak applications." >&2
        cleanup_errors+=("user Flatpak listing")
        continue
      fi
    fi
    while IFS= read -r app_id; do
      [[ -n "$app_id" ]] || continue
      if is_preserved_flatpak "$app_id"; then
        printf 'PRESERVED (declared in BlueBuild recipe): %s [%s]\\n' "$app_id" "$scope"
        continue
      fi
      printf 'Removing extra Flatpak: %s [%s]\\n' "$app_id" "$scope"
      if [[ "$scope" == system ]]; then
        if sudo flatpak uninstall --system --delete-data --assumeyes "$app_id"; then
          printf 'Removed: %s [system Flatpak]\\n' "$app_id"
        else
          printf 'ERROR: Failed to remove system Flatpak: %s\\n' "$app_id" >&2
          cleanup_errors+=("$app_id [system Flatpak]")
        fi
      else
        if flatpak uninstall --user --delete-data --assumeyes "$app_id"; then
          printf 'Removed: %s [user Flatpak]\\n' "$app_id"
        else
          printf 'ERROR: Failed to remove user Flatpak: %s\\n' "$app_id" >&2
          cleanup_errors+=("$app_id [user Flatpak]")
        fi
      fi
    done <<< "$installed_output"
  done

  if [[ -d "$HOME/.var/app" ]]; then
    for app_data in "$HOME/.var/app"/*; do
      [[ -e "$app_data" || -L "$app_data" ]] || continue
      app_id="${app_data##*/}"
      if is_preserved_flatpak "$app_id"; then
        printf 'PRESERVED app data (declared in BlueBuild recipe): %s\\n' "$app_id"
      else
        remove_paths "$app_data"
      fi
    done
  fi
}

echo "Fedora Niri Cleanup"
echo "Choose which user-level changes and data to remove. Image-provided system packages and services are kept."
echo

# Restore module-managed files before deleting caches or application data.
if ask "Restore and remove Kitty configuration?"; then
  run_module_uninstall kitty || true
fi
if ask "Restore and remove Fcitx5 configuration and Rime Ice?"; then
  run_module_uninstall fcitx || true
fi
if ask "Restore and remove Neovim configuration?"; then
  run_module_uninstall nvim || true
fi
if ask "Restore and remove DMS, Niri, Quickshell and Greeter configuration?"; then
  run_module_uninstall dms || true
fi

if ask "Remove extra system and user Flatpak applications not declared in the BlueBuild recipe?"; then
  remove_flatpaks || true
fi

if ask "Remove application data in ~/.local/share (excluding Flatpak data) and ~/.local/state (excluding Fedora Niri recovery records)?"; then
  if [[ -d "$HOME/.local/share" ]]; then
    find "$HOME/.local/share" -mindepth 1 -maxdepth 1 ! -name flatpak -exec rm -rf -- {} + ||
      { echo "ERROR: Failed to clean ~/.local/share application data." >&2; cleanup_errors+=("~/.local/share application data"); }
  fi
  if [[ -d "$HOME/.local/state" ]]; then
    find "$HOME/.local/state" -mindepth 1 -maxdepth 1 ! -name fedora-niri -exec rm -rf -- {} + ||
      { echo "ERROR: Failed to clean ~/.local/state application data." >&2; cleanup_errors+=("~/.local/state application data"); }
  fi
fi

if ask "Remove remaining user configuration files under ~/.config?"; then
  remove_paths "$HOME/.config"
fi

if ask "Remove user cache (~/.cache)?"; then
  remove_paths "$HOME/.cache"
fi

if ask "Remove XDG user directories (Desktop, Documents, Downloads, Music, Pictures, Public, Templates and Videos)?"; then
  remove_paths "$HOME/Desktop" "$HOME/Documents" "$HOME/Downloads" "$HOME/Music" "$HOME/Pictures" "$HOME/Public" "$HOME/Templates" "$HOME/Videos"
  remove_paths "$HOME/.config/user-dirs.conf" "$HOME/.config/user-dirs.locale"
fi

if ask "Remove remaining personal files and directories in HOME (including SSH/GPG keys and hidden files)?"; then
  for entry in "$HOME"/* "$HOME"/.[!.]* "$HOME"/..?*; do
    [[ -e "$entry" || -L "$entry" ]] || continue
    case "$entry" in
      "$HOME/.cache"|"$HOME/.local"|"$HOME/.var"|"$HOME/.config"|"$HOME/Desktop"|"$HOME/Documents"|"$HOME/Downloads"|"$HOME/Music"|"$HOME/Pictures"|"$HOME/Public"|"$HOME/Templates"|"$HOME/Videos") ;;
      *) remove_paths "$entry" ;;
    esac
  done
fi

if (("${#cleanup_errors[@]}" > 0)); then
  echo
  echo "Cleanup finished with errors in the following targets:" >&2
  printf '  - %s\\n' "${cleanup_errors[@]}" >&2
  exit 1
fi

echo
echo "Cleanup completed successfully."
echo "Image-provided RPM packages, system services and recipe-declared Flatpak applications were preserved."
echo "Log out and back in to apply session changes."
