#!/usr/bin/env bash
set -Eeuo pipefail
: "${HOME:?HOME is not set}"
yes=false
while (($#)); do case "$1" in -y|--yes) yes=true ;; *) echo "未知参数：$1" >&2; exit 2 ;; esac; shift; done
ask() {
  local prompt="$1" answer
  if [[ "$yes" == true ]]; then return 0; fi
  printf '%s [Y/n] ' "$prompt"
  IFS= read -r answer || answer=""
  [[ "${answer,,}" != n && "${answer,,}" != no ]]
}
config=false; cache=false; appdata=false; personal=false; userflatpak=false
echo "清理当前用户数据。系统级 Flatpak（镜像 recipe 中预装的应用）、RPM、系统镜像和其他用户均保留。"
ask "删除用户配置（~/.config、shell 配置等）？" && config=true
ask "删除缓存（~/.cache）？" && cache=true
ask "删除应用数据（~/.local/share 中除 flatpak 外的数据、~/.var/app）？" && appdata=true
ask "删除个人文件（桌面、文档、下载、图片等）？" && personal=true
ask "卸载当前用户安装的 Flatpak 应用及数据？" && userflatpak=true
if [[ "$yes" != true ]]; then
  printf '\n将按以上选择执行。输入 CLEAN 确认：'
  IFS= read -r answer || answer=""
  [[ "$answer" == CLEAN ]] || { echo "已取消。"; exit 0; }
fi
if [[ "$userflatpak" == true ]] && command -v flatpak >/dev/null; then
  flatpak uninstall --user --all --delete-data --assumeyes
fi
[[ "$config" == true ]] && rm -rf -- "$HOME/.config" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.gitconfig" "$HOME/.vimrc"
[[ "$cache" == true ]] && rm -rf -- "$HOME/.cache"
if [[ "$appdata" == true ]]; then
  rm -rf -- "$HOME/.var/app"
  mkdir -p "$HOME/.local/share"
  find "$HOME/.local/share" -mindepth 1 -maxdepth 1 ! -name flatpak -exec rm -rf -- {} +
  rm -rf -- "$HOME/.local/state"
fi
if [[ "$personal" == true ]]; then
  for entry in "$HOME"/* "$HOME"/.[!.]* "$HOME"/..?*; do
    [[ -e "$entry" || -L "$entry" ]] || continue
    case "$entry" in "$HOME/.config"|"$HOME/.cache"|"$HOME/.local"|"$HOME/.var") ;; *) rm -rf -- "$entry" ;; esac
  done
fi
if [[ "$userflatpak" == true ]]; then rm -rf -- "$HOME/.local/share/flatpak"; fi
echo "清理完成。系统级 Flatpak 和系统软件包未被卸载。"
