#!/usr/bin/env bash
set -Eeuo pipefail
: "${HOME:?HOME is not set}"

if (($# > 1)) || { (($# == 1)) && [[ "$1" != "-y" ]]; }; then
  echo "用法：just cleanup [-y]" >&2
  exit 2
fi

remove_user_flatpaks=false
remove_config=false
remove_cache=false
remove_appdata=false
remove_user_dirs=false
remove_personal=false

if [[ "${1:-}" == "-y" ]]; then
  # -y means accept every destructive cleanup category.
  remove_user_flatpaks=true
  remove_config=true
  remove_cache=true
  remove_appdata=true
  remove_user_dirs=true
  remove_personal=true
else
  ask() {
    local label="$1" answer
    printf '%s [Y/n] ' "$label"
    IFS= read -r answer || return 1
    case "${answer,,}" in n|no) return 1 ;; *) return 0 ;; esac
  }

  echo "清理当前用户环境。项目镜像预装的系统级 Flatpak、RPM、系统镜像和其他用户始终保留。"
  ask "删除用户配置（~/.config、shell 配置等）？" && remove_config=true
  ask "删除缓存（~/.cache）？" && remove_cache=true
  ask "删除用户应用数据（~/.local/share 中非 Flatpak 数据、~/.local/state、~/.var/app）？" && remove_appdata=true
  ask "删除 XDG 用户目录（桌面、文档、下载、图片、音乐、视频等）？" && remove_user_dirs=true
  ask "删除 HOME 中其他个人文件和隐藏目录（包括 SSH/GPG 密钥等）？" && remove_personal=true
  ask "卸载用户级 Flatpak 应用及其数据？" && remove_user_flatpaks=true
fi

# User XDG directories are handled separately from other HOME contents.
user_dirs=(
  "$HOME/Desktop" "$HOME/Documents" "$HOME/Downloads"
  "$HOME/Music" "$HOME/Pictures" "$HOME/Public"
  "$HOME/Templates" "$HOME/Videos"
)

if [[ "$remove_user_flatpaks" == true ]]; then
  if command -v flatpak >/dev/null 2>&1; then
    flatpak uninstall --user --all --delete-data --assumeyes
  else
    echo "未找到 flatpak 命令；将清理用户级 Flatpak 文件目录。"
  fi
  rm -rf -- "$HOME/.local/share/flatpak"
fi

if [[ "$remove_config" == true ]]; then
  rm -rf -- "$HOME/.config" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.gitconfig" "$HOME/.vimrc"
fi
if [[ "$remove_cache" == true ]]; then
  rm -rf -- "$HOME/.cache"
fi
if [[ "$remove_appdata" == true ]]; then
  rm -rf -- "$HOME/.var/app"
  mkdir -p "$HOME/.local/share"
  find "$HOME/.local/share" -mindepth 1 -maxdepth 1 ! -name flatpak -exec rm -rf -- {} +
  rm -rf -- "$HOME/.local/state"
fi
if [[ "$remove_user_dirs" == true ]]; then
  rm -rf -- "${user_dirs[@]}"
fi
if [[ "$remove_personal" == true ]]; then
  for entry in "$HOME"/* "$HOME"/.[!.]* "$HOME"/..?*; do
    [[ -e "$entry" || -L "$entry" ]] || continue
    case "$entry" in
      "$HOME/.config"|"$HOME/.cache"|"$HOME/.local"|"$HOME/.var"|"$HOME/Desktop"|"$HOME/Documents"|"$HOME/Downloads"|"$HOME/Music"|"$HOME/Pictures"|"$HOME/Public"|"$HOME/Templates"|"$HOME/Videos") ;;
      *) rm -rf -- "$entry" ;;
    esac
  done
fi

echo "清理完成。项目镜像预装的系统级 Flatpak 应用未被卸载。建议注销并重新登录。"
