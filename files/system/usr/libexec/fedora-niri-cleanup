#!/usr/bin/env bash
set -Eeuo pipefail
: "${HOME:?HOME is not set}"
yes=false
while (($#)); do
  case "$1" in -y|--yes) yes=true ;; *) echo "未知参数：$1" >&2; exit 2 ;; esac
  shift
done

ask() {
  local label="$1" answer
  if [[ "$yes" == true ]]; then return 0; fi
  printf '%s [Y/n] ' "$label"
  IFS= read -r answer || answer=""
  case "${answer,,}" in n|no) return 1 ;; *) return 0 ;; esac
}

remove_user_flatpaks=false
remove_config=false
remove_cache=false
remove_appdata=false
remove_personal=false

echo "清理当前用户环境。项目镜像预装的系统级 Flatpak、RPM、系统镜像和其他用户始终保留。"
ask "删除用户配置（~/.config、shell 配置等）？" && remove_config=true
ask "删除缓存（~/.cache）？" && remove_cache=true
ask "删除用户应用数据（~/.local/share 中非 Flatpak 数据、~/.var/app）？" && remove_appdata=true
ask "删除个人文件和下载内容（Documents、Downloads、Pictures 等及 HOME 其他普通文件）？" && remove_personal=true
ask "卸载用户级 Flatpak 应用及其数据？" && remove_user_flatpaks=true

# A final guard is kept even with -y because the operation can erase personal files.
if [[ "$yes" != true ]]; then
  printf '\n将按以上选择清理。输入 RESET 执行：'
  IFS= read -r answer || answer=""
  [[ "$answer" == RESET ]] || { echo "已取消。"; exit 0; }
fi


if [[ "$remove_user_flatpaks" == true ]]; then
  if command -v flatpak >/dev/null 2>&1; then
    flatpak uninstall --user --all --delete-data --assumeyes
  else
    echo "未找到 flatpak 命令；将清理用户级 Flatpak 文件目录。"
  fi
fi

if [[ "$remove_config" == true ]]; then
  rm -rf -- "$HOME/.config" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.gitconfig" "$HOME/.vimrc"
fi
if [[ "$remove_cache" == true ]]; then rm -rf -- "$HOME/.cache"; fi
if [[ "$remove_appdata" == true ]]; then
  rm -rf -- "$HOME/.var/app"
  mkdir -p "$HOME/.local/share"
  find "$HOME/.local/share" -mindepth 1 -maxdepth 1 ! -name flatpak -exec rm -rf -- {} +
  rm -rf -- "$HOME/.local/state"
fi
if [[ "$remove_personal" == true ]]; then
  for entry in "$HOME"/* "$HOME"/.[!.]* "$HOME"/..?*; do
    [[ -e "$entry" || -L "$entry" ]] || continue
    case "$entry" in
      "$HOME/.config"|"$HOME/.cache"|"$HOME/.local"|"$HOME/.var") ;;
      *) rm -rf -- "$entry" ;;
    esac
  done
fi
# Remove now-empty user state directories only; keep user Flatpak installation when requested.
if [[ "$remove_user_flatpaks" == true ]]; then rm -rf -- "$HOME/.local/share/flatpak"; fi
echo "清理完成。项目镜像预装的系统级 Flatpak 应用未被卸载。建议注销并重新登录。"
