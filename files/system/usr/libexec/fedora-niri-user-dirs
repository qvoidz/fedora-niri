#!/usr/bin/env bash
set -euo pipefail
: "${HOME:?HOME is not set}"
command -v xdg-user-dirs-update >/dev/null || {
  echo "缺少 xdg-user-dirs-update，请确认镜像安装了 xdg-user-dirs。" >&2
  exit 1
}

declare -A names=(
  ["文档"]="Documents" ["下载"]="Downloads" ["图片"]="Pictures"
  ["音乐"]="Music" ["视频"]="Videos" ["桌面"]="Desktop"
  ["模板"]="Templates" ["公共"]="Public"
)
mkdir -p "$HOME"
for old in "${!names[@]}"; do
  new="${names[$old]}"
  if [[ -d "$HOME/$old" && ! -e "$HOME/$new" ]]; then
    mv -- "$HOME/$old" "$HOME/$new"
  elif [[ -d "$HOME/$old" && -e "$HOME/$new" ]]; then
    echo "保留旧目录（英文目录已存在，未自动合并）：$HOME/$old"
  fi
  mkdir -p "$HOME/$new"
done

mkdir -p "$HOME/.config"
LC_ALL=C xdg-user-dirs-update --set DOCUMENTS "$HOME/Documents"
LC_ALL=C xdg-user-dirs-update --set DOWNLOAD "$HOME/Downloads"
LC_ALL=C xdg-user-dirs-update --set PICTURES "$HOME/Pictures"
LC_ALL=C xdg-user-dirs-update --set MUSIC "$HOME/Music"
LC_ALL=C xdg-user-dirs-update --set VIDEOS "$HOME/Videos"
LC_ALL=C xdg-user-dirs-update --set DESKTOP "$HOME/Desktop"
LC_ALL=C xdg-user-dirs-update --set TEMPLATES "$HOME/Templates"
LC_ALL=C xdg-user-dirs-update --set PUBLICSHARE "$HOME/Public"

# Prevent locale changes from translating these paths back to localized names.
cat > "$HOME/.config/user-dirs.conf" <<'EOF'
enabled=False
EOF
printf 'C\n' > "$HOME/.config/user-dirs.locale"
echo "XDG 用户目录已固定为英文名称。当前桌面会话中的应用可能需要重新登录后读取新路径。"
