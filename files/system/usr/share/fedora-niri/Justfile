# Global Justfile for the Fedora Niri image.
# JUST_JUSTFILE points here so every user can run plain "just".

default:
    @just --list

dms-setup yes="":
    exec bash /usr/libexec/fedora-niri/dms-setup {{yes}}

kitty-setup yes="":
    exec bash /usr/libexec/fedora-niri/kitty-setup {{yes}}

fcitx-setup yes="":
    exec bash /usr/libexec/fedora-niri/fcitx-setup {{yes}}


nvim-setup yes="":
    exec bash /usr/libexec/fedora-niri/nvim-setup {{yes}}

cleanup yes="":
    exec bash /usr/libexec/fedora-niri/cleanup {{yes}}

user-dirs yes="":
    exec bash /usr/libexec/fedora-niri/user-dirs {{yes}}
