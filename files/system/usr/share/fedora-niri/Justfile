    exec bash /usr/libexec/fedora-niri/niri-setup {{yes}}

kitty-setup yes="":
    exec bash /usr/libexec/fedora-niri/kitty-setup {{yes}}

fcitx-setup yes="":
    exec bash /usr/libexec/fedora-niri/fcitx-setup {{yes}}

nvim-setup yes="":
    exec bash /usr/libexec/fedora-niri/nvim-setup {{yes}}

cleanup yes="":
    exec bash /usr/libexec/fedora-niri/cleanup {{yes}}
